<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules up to Android 11 (data_extraction_rules.xml from Android 12). Only the user's choices are
    backed up: the selected decks and the focus settings (nudges, app gate, pauses, the PC pairing, the theme).
    The displayed card and the review timer are left out: restored on a new phone, they would start the app with a
    card from the old collection. The few states kept in the focus file (snooze, gate pass, emergency skips used
    today) expire by themselves.
    Keep the list in sync with data_extraction_rules.xml.
-->
<full-backup-content>
    <include domain="sharedpref" path="com.ankidroid.companion.deck_selection.xml" />
    <include domain="sharedpref" path="com.orlikalabs.microreview.focus.xml" />
    <include domain="sharedpref" path="com.orlikalabs.microreview.move.xml" />
    <include domain="sharedpref" path="com.orlikalabs.microreview.life.xml" />
</full-backup-content>
