<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device transfer rules from Android 12 (backup_rules.xml up to Android 11): only the user's
    choices, not the displayed card or the session state. Keep the list in sync with backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="com.ankidroid.companion.deck_selection.xml" />
        <include domain="sharedpref" path="com.orlikalabs.microreview.focus.xml" />
        <include domain="sharedpref" path="com.orlikalabs.microreview.move.xml" />
        <include domain="sharedpref" path="com.orlikalabs.microreview.life.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="com.ankidroid.companion.deck_selection.xml" />
        <include domain="sharedpref" path="com.orlikalabs.microreview.focus.xml" />
        <include domain="sharedpref" path="com.orlikalabs.microreview.move.xml" />
        <include domain="sharedpref" path="com.orlikalabs.microreview.life.xml" />
    </device-transfer>
</data-extraction-rules>
