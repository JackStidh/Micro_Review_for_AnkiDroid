    <!-- Errors -->
    <string name="error_api_unavailable_title">AnkiDroid not available</string>
    <string name="error_api_unavailable">Either AnkiDroid is not installed, or its API is disabled. Enable it in AnkiDroid: Settings › Advanced › Enable AnkiDroid API.</string>
    <string name="error_permission_title">Permission needed</string>
    <string name="error_permission">Micro Review for AnkiDroid needs access to your AnkiDroid cards to show them.</string>
    <string name="error_load_failed_title">Can\'t read your decks</string>
    <string name="error_load_failed">AnkiDroid didn\'t give its decks: it may be updating, or its collection may be closed. Open AnkiDroid, then retry. If you just enabled its API, close AnkiDroid from the recent apps and open it again first.</string>
    <string name="grant_permission">Grant access</string>
    <string name="retry">Retry</string>
    <string name="notification_permission_denied">Notifications are disabled: the monitor\'s notification and its Snooze buttons won\'t show. Enable them in the app\'s system settings.</string>
    <string name="permission_not_granted">Permission to read AnkiDroid cards was not granted.</string>

