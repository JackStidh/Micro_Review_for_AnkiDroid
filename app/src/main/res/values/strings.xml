    <string name="focus_title">Cards while you use your phone</string>
    <string name="focus_choose">Choose</string>
    <string name="focus_setup">Finish setting up</string>
    <string name="focus_setup_restricted">If Android says a setting is restricted for this app: open the app\'s info page (long-press its icon, then App info), tap the three dots, then \"Allow restricted settings\", and come back.</string>
    <string name="focus_setup_allow">Allow</string>
    <string name="focus_setup_usage">Usage access</string>
    <string name="focus_setup_usage_detail">Lets the app see which app is in front, to time the cards per app and to gate the apps you chose. Nothing leaves your phone.</string>
    <string name="focus_setup_overlay">Display over other apps</string>
    <string name="focus_setup_overlay_detail">Lets the gate and full-screen cards open over the app in front.</string>
    <string name="focus_setup_notifications">Notifications</string>
    <string name="focus_setup_notifications_detail">For the monitor\'s notification, its Snooze buttons, and a card when it can\'t take the screen.</string>

    <string name="focus_snooze">Snooze</string>
    <string name="focus_snooze_detail">No cards for a while. Also on the monitor\'s notification and on each card.</string>
    <string name="focus_snooze_length">Snooze button on a card</string>
    <string name="focus_snooze_lifts_gate">Snooze also opens the gate</string>
    <string name="focus_snooze_lifts_gate_detail">Off: a snooze stops the cards, but gated apps still ask for theirs.</string>

    <string name="focus_nudges">Cards while you use your phone</string>
    <string name="focus_nudges_enable">Send me cards</string>
    <string name="focus_nudges_detail">A card pops up every so often, only while the screen is on and unlocked, never on the lock screen. Answer it and you\'re done, or keep going. A card you don\'t touch is withdrawn, so its time doesn\'t count.</string>
    <string name="focus_default_interval">A card every</string>
    <string name="focus_interval_every">Every %1$d min</string>
    <string name="focus_interval_never">Never</string>
    <string name="focus_interval_default">Like other apps</string>
    <string name="focus_app_intervals">Own timing per app</string>
    <string name="focus_app_intervals_none">None. For example a card every 5 minutes on your biggest time wasters, or never on your maps app.</string>
    <string name="focus_show_now">Show a card now</string>

    <string name="focus_answers">Answer buttons</string>
    <string name="focus_pass_fail">Pass / Fail only</string>
    <string name="focus_note_fields">Show the note\'s fields under the answer</string>
    <string name="focus_note_fields_detail">On the full-screen card: every field of the note the card didn\'t show, such as the meaning or the reading, so a definition left off the card\'s back is still there.</string>
    <string name="focus_pass_fail_detail">Pass records Good and Fail records Again. Hard and Easy are never offered, anywhere in the app.</string>

    <string name="focus_gate">App gate</string>
    <string name="focus_gate_enable">Ask for cards before chosen apps</string>
    <string name="focus_gate_detail">Opening one of them first asks for a few cards. Pass or Fail, each answer counts. No grace period: close the app and open it again, and it asks again. Nothing due means no gate.</string>
    <string name="focus_gate_apps">Gated apps</string>
    <string name="focus_gate_apps_none">None chosen yet.</string>
    <string name="focus_gate_cards">Cards per opening</string>
    <plurals name="focus_cards">
        <item quantity="one">%1$d card</item>
        <item quantity="other">%1$d cards</item>
    </plurals>
    <string name="focus_gate_skips">Emergency skips</string>
    <string name="focus_gate_skips_detail">%1$d per day</string>

    <string name="focus_pauses">When cards stay away</string>
    <string name="focus_bluetooth">While a Bluetooth device is connected</string>
    <string name="focus_bluetooth_detail">Everything pauses: no cards, and the gate is open. For example in the car or with headphones at work.</string>
    <string name="focus_bluetooth_permission">Detect every Bluetooth device</string>
    <string name="focus_bluetooth_permission_detail">Without the \"Nearby devices\" permission, only Bluetooth audio (car, headphones, speakers) is detected, not watches or keyboards.</string>
    <string name="focus_dnd">During Do Not Disturb</string>
    <string name="focus_dnd_detail">No cards while Do Not Disturb or another mode silences notifications.</string>
    <string name="focus_call">During calls</string>
    <string name="focus_call_detail">No cards while you are in a call.</string>
    <string name="focus_quiet">Quiet hours</string>
    <string name="focus_quiet_none">None. For example no cards from 22:00 to 07:00.</string>
    <string name="focus_quiet_add">Add</string>
    <string name="focus_quiet_clear">Remove the quiet hours</string>
    <string name="focus_quiet_from">Quiet from</string>
    <string name="focus_quiet_to">Until</string>
    <string name="focus_pc">Your PC</string>
    <string name="focus_pc_pair">Pause while my PC is in use</string>
    <string name="focus_pc_pair_detail">With Micro Review Desktop, the Anki add-on, on your PC: cards and the gate pause for 5 minutes after you last use its mouse or keyboard.</string>
    <string name="focus_pc_enter_code">Enter code</string>
    <string name="focus_pc_enter_code_detail">In Anki on your PC: Tools › Micro Review Desktop. Type the pairing code shown there.</string>
    <string name="focus_pc_bad_code">16 letters and digits, like k3p9-x2mq-7rtv-w8de</string>
    <string name="focus_pc_pause">Pause while my PC is in use</string>
    <string name="focus_pc_pause_detail">No cards, the gate is open, for 5 minutes after you last use your PC\'s mouse or keyboard. Your PC tells the phone through ntfy.sh, a free relay: only a number of seconds is sent.</string>
    <string name="focus_pc_paired">Paired with your PC</string>
    <string name="focus_pc_unpair">Unpair</string>
    <string name="focus_ankiweb">AnkiWeb</string>
    <string name="focus_ankiweb_sync">Sync AnkiDroid</string>
    <string name="focus_ankiweb_pending">Answers wait to be synced: as your next card screen closes, or now. Asked last: %1$s.</string>
    <string name="focus_ankiweb_synced">Nothing waiting. Asked AnkiDroid last: %1$s. AnkiDroid only syncs with its screen up for a moment, so it\'s only asked as a card screen closes, hidden behind it. Cards your PC reviewed are skipped until then.</string>
    <string name="syncing_cover">Syncing with AnkiWeb…</string>
    <string name="focus_ankiweb_never">never</string>
    <string name="focus_ankiweb_sync_now">Sync now</string>
