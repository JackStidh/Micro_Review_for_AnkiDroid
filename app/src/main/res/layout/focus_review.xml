<?xml version="1.0" encoding="utf-8"?>
<!-- The full-screen card (FocusCardController), in an overlay over the app in use (CardOverlay) or in
     FocusReviewActivity: the app gate, a nudge, or a "Keep going" session.
     Question, "Show answer", then the answer and the answer buttons; under them, what the mode offers
     (emergency skip, snooze, done). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focusRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/focusTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Title" />

    <TextView
        android:id="@+id/focusProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textAppearance="@android:style/TextAppearance.Material.Caption" />

    <ScrollView
        android:id="@+id/focusScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingVertical="24dp">

            <TextView
                android:id="@+id/focusQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@android:style/TextAppearance.Material.Headline"
                android:textIsSelectable="false" />

            <View
                android:id="@+id/focusDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="24dp"
                android:background="@color/notification_divider"
                android:visibility="gone" />

            <TextView
                android:id="@+id/focusAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@android:style/TextAppearance.Material.Subhead"
                android:textSize="20sp"
                android:visibility="gone" />

            <!-- The note's fields the card didn't show (NoteFields). -->
            <TextView
                android:id="@+id/focusFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingMultiplier="1.15"
                android:textAppearance="@android:style/TextAppearance.Material.Body1"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/focusMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@android:style/TextAppearance.Material.Subhead"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/focusShowAnswer"
        style="@style/FocusAnswerButton"
        android:layout_width="match_parent"
        android:layout_weight="0"
        android:background="@drawable/bg_pill_show_answer"
        android:text="@string/show_answer"
        android:textColor="@color/show_answer_button_text"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/focusAnswerButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/focusButton1"
            style="@style/FocusAnswerButton"
            android:background="@drawable/bg_pill_again"
            android:text="@string/again"
            android:textColor="@color/again_button_text" />

        <Button
            android:id="@+id/focusButton2"
            style="@style/FocusAnswerButton"
            android:background="@drawable/bg_pill_hard"
            android:text="@string/hard"
            android:textColor="@color/hard_button_text" />

        <Button
            android:id="@+id/focusButton3"
            style="@style/FocusAnswerButton"
            android:background="@drawable/bg_pill_good"
            android:text="@string/good"
            android:textColor="@color/good_button_text" />

        <Button
            android:id="@+id/focusButton4"
            style="@style/FocusAnswerButton"
            android:background="@drawable/bg_pill_easy"
            android:text="@string/easy"
            android:textColor="@color/easy_button_text" />
    </LinearLayout>

    <!-- Snooze lengths, under "Snooze" (FocusCardController). -->
    <LinearLayout
        android:id="@+id/focusSnoozeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/focusSnooze1"
            style="@android:style/Widget.Material.Button.Borderless.Colored"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/snooze_15_minutes"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/focusSnooze2"
            style="@android:style/Widget.Material.Button.Borderless.Colored"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/snooze_1_hour"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/focusSnooze3"
            style="@android:style/Widget.Material.Button.Borderless.Colored"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/snooze_3_hours"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/focusSnooze4"
            style="@android:style/Widget.Material.Button.Borderless.Colored"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/snooze_until_tomorrow"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/focusSecondary1"
            style="@android:style/Widget.Material.Button.Borderless.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:visibility="gone" />

        <Button
            android:id="@+id/focusSecondary2"
            style="@android:style/Widget.Material.Button.Borderless.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
