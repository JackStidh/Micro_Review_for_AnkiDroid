<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AnkiDroid's API (AnkiDroidContract): reading the decks and cards, recording the answers. -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Display over other apps": the card and the app gate are drawn over the app in use (CardOverlay). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- The usage monitor (UsageMonitorService): which app is in front, read from the usage events. Granted by the
         user in the system settings ("Usage access"), not at install. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- "While a Bluetooth device is connected" (BluetoothState): audio devices need nothing; every device needs
         "Nearby devices" (Android 12+), asked when the setting is turned on, or the old permission before. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- "Pause while my PC is in use" (PcActivity): reads the PC's messages from the relay. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether the phone is online before asking AnkiDroid to sync (AnkiSync). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />

    <queries>
        <!-- The apps of the launcher, to choose the gated apps and the apps with their own timing. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnkiNotifications"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/launcher_label"
            android:theme="@style/Theme.AnkiNotifications">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The app gate, a full-screen nudge or a "Keep going" session: opened over the app in front. -->
        <activity
            android:name=".FocusReviewActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.AnkiNotifications" />
        <activity
            android:name=".FocusSettingsActivity"
            android:exported="false"
            android:label="@string/focus_title"
            android:theme="@style/Theme.AnkiNotifications" />
        <!-- Watches which app is in front while the phone is in use, for the nudges and the app gate. -->
        <service
            android:name=".UsageMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the user's flashcards at intervals while the phone is in use and before apps the user chose, which needs the screen and app-in-front events for as long as the feature is on." />
        </service>
        <receiver android:name=".NotificationReceiver"/>
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
    <queries>
        <package android:name="com.ichi2.anki" />
    </queries>
</manifest>